<?xml version="1.0" encoding="UTF-8" ?>
<!-- Review scratch: builtin-equivalent SHM + UDPv4 (localhost), SHM healthy_check_timeout_ms 60 (port_wait 20 ms). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor><transport_id>shm_hc60</transport_id><type>SHM</type>
      <healthy_check_timeout_ms>60</healthy_check_timeout_ms></transport_descriptor>
    <transport_descriptor><transport_id>udp_lo</transport_id><type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_hc60_participant" is_default_profile="true">
    <rtps><userTransports><transport_id>shm_hc60</transport_id><transport_id>udp_lo</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports></rtps>
  </participant>
</profiles>
